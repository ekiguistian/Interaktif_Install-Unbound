server:
    verbosity: 0
    num-threads: 4

    interface: 127.0.0.1
    interface: 10.10.10.10
    port: 53
    do-ip4: yes
    do-ip6: no
    do-udp: yes
    do-tcp: yes

    access-control: 127.0.0.0/8 allow
    access-control: 10.10.10.0/24 allow

    so-reuseport: yes
    so-rcvbuf: 4m
    so-sndbuf: 4m

    msg-cache-size: 512m
    rrset-cache-size: 1536m
    key-cache-size: 128m
    msg-cache-slabs: 4
    rrset-cache-slabs: 4
    infra-cache-slabs: 4
    key-cache-slabs: 4

    cache-min-ttl: 60
    cache-max-ttl: 86400
    prefetch: yes
    prefetch-key: yes

    module-config: "validator iterator"
    harden-dnssec-stripped: yes
    harden-glue: yes
    hide-identity: yes
    hide-version: yes
    auto-trust-anchor-file: "/var/lib/unbound/root.key"
    root-hints: "/var/lib/unbound/root.hints"

    local-data-ptr: "10.10.10.10 resolver1.nexan.id."
    use-syslog: yes
    log-queries: yes
    log-replies: yes
    log-tag-queryreply: yes

# Optional: enable only after blocklist.conf has been created.
#    include: "/etc/unbound/blocklist/blocklist.conf"

forward-zone:
    name: "."
    forward-first: yes
    forward-addr: 1.1.1.1
    forward-addr: 8.8.8.8

remote-control:
    control-enable: yes
    control-interface: 127.0.0.1
    control-use-cert: yes
    server-key-file: "/etc/unbound/unbound_server.key"
    server-cert-file: "/etc/unbound/unbound_server.pem"
    control-key-file: "/etc/unbound/unbound_control.key"
    control-cert-file: "/etc/unbound/unbound_control.pem"
